# Copy to .env and edit.

# Postgres
POSTGRES_USER=edi
POSTGRES_PASSWORD=change_me
POSTGRES_DB=edi
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://edi:change_me@db:5432/edi

# Seed single-user identity + API key (auth for all /v1 endpoints via X-API-Key header)
EDI_USER_EMAIL=mahmoud.10987@gmail.com
EDI_API_KEY=change_me_to_a_long_random_string

# LLM provider: "stub" (default, no key needed) or "openai"
EDI_LLM_PROVIDER=stub
EDI_LLM_MODEL=gpt-5.6-terra
OPENAI_API_KEY=

# Embeddings provider: "stub" or "openai"
EDI_EMBEDDINGS_PROVIDER=stub

# Alert cooldown, in minutes, for unchanged alerts of the same dedup_key
EDI_ALERT_COOLDOWN_MINUTES=180
